/* Cloudflare settings for First Roll. Deploy with:  npx wrangler deploy
   Then add two secrets in the dashboard (Worker > Settings > Variables and Secrets):
   OPENAI_API_KEY and DM_PASSCODE. */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "first-roll",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  // public/ is not kept in git: wrangler builds it from src/ and cartridges/ before every deploy,
  // and again whenever a file in either folder changes while "npm run dev" is running
  "build": { "command": "node build.js", "watch_dir": ["src", "cartridges", "server"] },
  // the app's pages, pictures and scripts; anything under /api goes to worker.js
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // one small stateful object per table: players, handouts, painted pictures
  "durable_objects": { "bindings": [{ "name": "TABLES", "class_name": "Table" }] },
  "exports": { "Table": { "type": "durable-object", "storage": "sqlite" } },
  // a second speed bump for anyone guessing table codes or the passcode, shared between copies of the Worker
  "ratelimits": [{ "name": "GUESSES", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": true }
}
